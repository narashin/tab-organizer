{
  "name": "chrome-tab-wrapper",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/lint.mjs",
    "package": "npm run build && cd dist && zip -q -FS -r ../tab-organizer.zip .",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:tab-strip": "node scripts/capture-tab-strip.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/chrome": "0.2.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.6"
  }
}
